# Neon (recomendado): copia la cadena desde el boton Connect de Neon.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST/neondb?sslmode=require

# Puerto del backend.
PORT=3000

# HiveMQ Cloud. La contrasena real solo debe estar en .env.
MQTT_HOST=tu_cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=tu_usuario
MQTT_PASSWORD=tu_contrasena_segura

# Alternativa para PostgreSQL local: elimina o comenta DATABASE_URL y completa:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=tu_contrasena
# DB_NAME=rutalibre
